{
    "compilerOptions": {
        "module": "ES2022",
        "target": "ES2022",
        "lib": ["ES2022", "dom", "dom.iterable"],
        "rootDir": "./src",
        "outDir": "dist/",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "typeRoots": ["./node_modules/@types", "./types", "./node_modules/iitcpluginkit/types"],
        "types": ["jquery", "build_constances", "greasemonkey", "iitc", "jqueryui", "leaflet", "images", "node"],
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true
    },
    "types": ["webpack-env"],
    "files": ["src/Main.ts"],
    "include": ["types/*.d.ts", "./src/**/*"]
}

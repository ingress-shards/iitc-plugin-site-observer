{
    "compilerOptions": {
        "module": "ES2022",
        "target": "ES2022",
        "lib": ["ES2022", "dom"],
        "outDir": "dist/",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "typeRoots": ["./node_modules/@types", "./types", "./node_modules/iitcpluginkit/types"],
        "types": ["jquery", "build_constances", "greasemonkey", "iitc", "jqueryui", "leaflet", "images", "node"],
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "baseUrl": ".",
        "paths": {
            "@ingress-shards/ingress-events-core": [
                "../ingress-events-core/dist/index.d.mts",
                "./node_modules/@ingress-shards/ingress-events-core/dist/index.d.mts"
            ],
            "@ingress-shards/ingress-events-core/*": [
                "../ingress-events-core/dist/*",
                "./node_modules/@ingress-shards/ingress-events-core/dist/*"
            ]
        }
    },
    "types": ["webpack-env"],
    "files": ["src/Main.ts"],
    "include": ["types/*.d.ts", "./src/**/*"]
}
